# JWT của Pinata (lấy ở app.pinata.cloud > API Keys). TUYỆT ĐỐI không commit file .env thật.
PINATA_JWT=
# Gateway IPFS dùng để tải file (tùy chọn). Tài khoản Pinata mới thường có gateway riêng dạng https://<tên>.mypinata.cloud
PINATA_GATEWAY=https://gateway.pinata.cloud
# Địa chỉ frontend được phép gọi backend (CORS)
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000
