# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example

# Chỉ giữ run-latest.json làm bằng chứng deploy; bỏ các bản sao theo timestamp và file khóa
/broadcast/**/run-[0-9]*.json
/broadcast/**/*.recovery.lock
